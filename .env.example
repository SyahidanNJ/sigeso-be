PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sigeso_db
JWT_SECRET=ganti-min-32-karakter-di-sini
LLM_KEY_SECRET=ganti-32-karakter-untuk-enkripsi-key
# Provider default (OpenAI-compatible: Inception Labs, Apmix, OpenAI, OpenRouter, Ollama)
LLM_BASE_URL=https://api.inceptionlabs.ai/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=mercury-3
TYPST_BIN=typst
PANDOC_BIN=pandoc
# Email untuk tautan reset kata sandi. Gmail: App Password (bukan sandi akun).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=alamat@gmail.com
SMTP_PASS=16-huruf-app-password
MAIL_FROM=Sigeso <alamat@gmail.com>
# Alamat aplikasi yang dipakai di tautan email (tanpa garis miring di akhir).
APP_URL=http://localhost:5173
# ringkas = 1 baris mudah dibaca (dev), json = pino JSON (docker/prod)
REQUEST_LOG=ringkas
